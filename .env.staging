# Staging / Dev 环境配置

# 应用标题
VITE_APP_TITLE = "BTCommunity"

# API 基础路径（后端接口前缀，需与 nginx 反向代理或后端地址一致）
VITE_BASE_URL = /api

# 路由模式：hash 或 html5
VITE_ROUTER_HISTORY = html5

# 公共基础路径（部署到子路径时修改，如 /admin/）
VITE_PUBLIC_PATH = /

# ---- 以下仅 vite dev server 使用，构建时不生效 ----

# 开发服务器端口
VITE_CLI_PORT = 5173

# 后端服务地址（反向代理目标）
VITE_BASE_PATH = http://127.0.0.1

# 后端服务端口
VITE_SERVER_PORT = 8888